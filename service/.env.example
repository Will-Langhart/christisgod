# Copy to `.env` and fill in. `.env` is gitignored — never commit real keys.
#   cp .env.example .env    then paste your key below.

# Required for any real graph run (interlocutor / apologist / guardrail nodes).
ANTHROPIC_API_KEY=

# Optional — LangSmith tracing of the multi-agent loops (AI-SPEC.md §2).
# LANGSMITH_API_KEY=
# LANGSMITH_TRACING=true
# LANGSMITH_PROJECT=christisgod-debate

# Optional overrides (defaults in graph/config.py):
# APOLOGIST_MODEL=claude-sonnet-5
# GUARDRAIL_MODEL=claude-sonnet-5
# INTERLOCUTOR_MODEL=claude-haiku-4-5
# DEBATE_MAX_RETRIES=3
# RETRIEVER_TOP_K=6
